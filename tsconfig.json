{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "node"
    ],
    "jsx": "react-jsx",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ],
      "@test/*": [
        "./tests/test-utils/*"
      ],
      "@functions/*": [
        "./functions/*"
      ],
      "@server/*": [
        "./server/*"
      ]
    },
    "allowImportingTsExtensions": true
  },
  "include": [
    "src",
    "shared"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
