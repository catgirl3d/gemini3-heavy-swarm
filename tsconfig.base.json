{
  "compilerOptions": {
    "target": "ES2022",
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "moduleDetection": "force",
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    // TEMPORARY: Re-enable after indexed array/object access is migrated to
    // explicit guards or safe access helpers across the existing codebase.
    "noUncheckedIndexedAccess": false,
    // TEMPORARY: Re-enable after optional settings fields distinguish omitted
    // properties from explicit undefined values throughout the app and tests.
    "exactOptionalPropertyTypes": false,
    "allowJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["./shared/*"]
    }
  }
}
