# Google Gemini API key (required for Native Gemini or Proxy mode)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API key (required for OpenRouter via proxy)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Anti-abuse secret handshake (must match VITE_API_SECRET)
# These two MUST be the SAME value
API_SECRET=your-secret-here
VITE_API_SECRET=your-secret-here

# Proxy behavior: 'demo' (restricted models) or 'private' (all models)
# Default: private
PROXY_MODE=private

# Disable forced proxy in development mode (true/false)
VITE_FORCE_PROXY_OFF=false

# Backend server port (defaults to 8080)
PORT=8080
