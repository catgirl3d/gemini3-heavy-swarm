{
  "name": "gemini-3-heavy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:proxy": "tsx server/server.ts",
    "dev:do": "wrangler dev --config workers/rate-limiter/wrangler.jsonc",
    "dev:all": "concurrently \"npm run dev:proxy\" \"npm run dev\" --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\"",
    "build": "vite build",
    "typecheck": "npm run typecheck:app && npm run typecheck:server && npm run typecheck:functions && npm run typecheck:tests && npm run typecheck:tests:functions && npm run typecheck:do",
    "typecheck:app": "tsc -p tsconfig.json --noEmit",
    "typecheck:server": "tsc -p server/tsconfig.json --noEmit",
    "typecheck:functions": "tsc -p functions/tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "typecheck:tests:functions": "tsc -p tests/functions/tsconfig.json --noEmit",
    "typecheck:do": "tsc -p workers/rate-limiter/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=esm --outfile=server-build/server.js --packages=external",
    "start:server": "node server-build/server.js",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && wrangler pages deploy dist --project-name gemini3-heavy-swarm",
    "deploy:do": "wrangler deploy --config workers/rate-limiter/wrangler.jsonc"
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "gpt-tokenizer": "^3.4.0",
    "react": "^19.1.1",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.1.5",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "happy-dom": "^20.0.11",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.2.0",
    "vitest": "^4.0.16",
    "wrangler": "^4.51.0"
  }
}
