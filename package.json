{
  "name": "gemini-3-heavy",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:proxy": "tsx server/server.ts",
    "dev:all": "concurrently \"npm run dev:proxy\" \"npm run dev\" --names \"SERVER,CLIENT\" --prefix-colors \"blue,green\"",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:server": "esbuild server/server.ts --bundle --platform=node --format=esm --outfile=server-build/server.js --packages=external",
    "start:server": "node server-build/server.js",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "npm run build && wrangler pages deploy dist"
  },
  "dependencies": {
    "@google/genai": "^1.16.0",
    "dotenv": "^17.2.3",
    "express": "^4.18.2",
    "react": "^19.1.1",
    "react-dom": "^19.2.0",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.27.2",
    "tsx": "^4.19.3",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.0.16",
    "wrangler": "^4.51.0"
  }
}
